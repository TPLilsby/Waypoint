# Supabase project credentials. Copy this file to .env.local and fill in the
# values from your Supabase project settings (Project Settings -> API).
# .env.local is gitignored and must never be committed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Free key from https://www.nps.gov/subjects/developer/get-started.htm.
# Server-only - do not prefix with NEXT_PUBLIC_, it would ship to the browser.
NPS_API_KEY=
